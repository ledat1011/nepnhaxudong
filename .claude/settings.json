{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\"" }] }]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-seo@agricidaniel-claude-seo": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "antislop@anti-slop": true,
    "taste-skill@taste-skill": true,
    "gsap-skills@gsap-skills": true
  },
  "extraKnownMarketplaces": {
    "agricidaniel-claude-seo": { "source": { "source": "github", "repo": "AgriciDaniel/claude-seo" } },
    "karpathy-skills": { "source": { "source": "github", "repo": "forrestchang/andrej-karpathy-skills" } },
    "anti-slop": { "source": { "source": "github", "repo": "miqdadbadjuber/anti-slop", "ref": "v3.2.25" } },
    "taste-skill": { "source": { "source": "github", "repo": "leonxlnx/taste-skill", "ref": "v2.1.5" } },
    "gsap-skills": { "source": { "source": "github", "repo": "greensock/gsap-skills" } }
  },
  "permissions": {
    "allow": ["Bash(npm run test:tools)", "Bash(node --test:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
