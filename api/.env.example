# Sample values only. Copy to a real environment; never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5433/nepnha
DB_USER=nepnha
# Local value used by infra/compose.dev.yml. Use a strong password everywhere else.
DB_PASSWORD=nepnha-local
# First admin: created at startup only when the app_user table is empty (sample values).
# The admin must change the password at the first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-sample-password
# Folder of the uploaded images (optional; default ./data/media).
# MEDIA_DIR=./data/media
# Address of the website (Next.js). After a content change the API tells it to refresh its pages.
# A blank or missing value means the website is not running and the API makes no refresh calls.
# In production this is the internal address of the web container, for example http://web:3000.
# WEB_BASE_URL=http://localhost:3000
# Sample value. Must be the same as REVALIDATE_SECRET of the website. Use a long random value everywhere else.
# REVALIDATE_SECRET=doi-gia-tri-nay
