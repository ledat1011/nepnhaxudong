# Sample values only. Copy to a real environment; never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5433/nepnha
DB_USER=nepnha
# Local value used by infra/compose.dev.yml. Use a strong password everywhere else.
DB_PASSWORD=nepnha-local
# First admin: created at startup only when the app_user table is empty (sample values).
# The admin must change the password at the first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-sample-password
