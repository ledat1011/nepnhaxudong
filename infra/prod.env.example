# Example of /opt/nepnha/.env on the VPS. infra/vps/init-env.sh writes the real file with random secrets.
# Never commit the real file. Keep it with mode 600.

# Public host name. Before the domain exists: the IP with dashes + .sslip.io (for 203.0.113.7: 203-0-113-7.sslip.io).
# Must match the GitHub variable SITE_HOST (the web image is built with https://<SITE_HOST>).
SITE_HOST=203-0-113-7.sslip.io
# acme: Let's Encrypt over HTTP. cloudflare: certificate over the Cloudflare DNS API (needs CLOUDFLARE_API_TOKEN,
# a token with Zone.DNS edit for the domain). Use cloudflare once the domain is proxied by Cloudflare.
TLS_MODE=acme
CLOUDFLARE_API_TOKEN=

# Images. deploy.sh updates IMAGE_TAG on each deploy.
IMAGE_PREFIX=ghcr.io/ledat1011
IMAGE_TAG=

# Database password (random, 32+ characters).
POSTGRES_PASSWORD=
# Shared secret between the API and the web app for POST /api/revalidate (random, 32+ characters).
REVALIDATE_SECRET=
# First admin. The API creates it only while the app_user table is empty. The password must be changed at the
# first login; after that, delete the password line from this file.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Folder of the uploaded images on the VPS (owned by UID 10001, the API user).
MEDIA_HOST_DIR=/srv/nepnha/media

# Backups (infra/backup/backup.sh). Without a cloud bucket the repository stays on the VPS.
# Backblaze B2 example: s3:https://s3.<region>.backblazeb2.com/<bucket>/nepnha
RESTIC_REPOSITORY=/srv/nepnha/backup/restic
# Keep a copy of this password outside the VPS: without it no backup can be read.
RESTIC_PASSWORD=
# Key ID and application key of the bucket (B2, R2 or another S3 store). Empty for a local repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Ping URL from healthchecks.io for the nightly backup (for example https://hc-ping.com/<uuid>). Empty: no ping.
HEALTHCHECK_URL=
# A second healthchecks.io check for the monthly restore test (its own result). Empty: no ping.
RESTORE_HEALTHCHECK_URL=
