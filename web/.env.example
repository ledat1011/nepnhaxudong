# Content source: "mock" (built-in sample data, no API needed) or "api" (real API).
CONTENT_SOURCE=mock
# Base URL of the API, without a trailing /api.
API_BASE_URL=http://localhost:8080
# Public origin of the site, without a trailing slash. Image URLs starting with
# "/" are loaded from here. next.config.ts reads it at BUILD time, so the
# production build must run with the real value.
SITE_URL=http://localhost:3000
# Sample value. Must be the same as REVALIDATE_SECRET of the API.
REVALIDATE_SECRET=doi-gia-tri-nay
